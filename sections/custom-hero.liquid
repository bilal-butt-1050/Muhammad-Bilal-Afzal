<style>
  .custom-hero-wrapper {
    width: 100%;
    background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    opacity: 1;
  }

  .custom-hero {
    width: 100%;
    max-width: 1440px;
    height: 878px;
    min-height: 878px;
    margin: 0 auto;
    background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    position: relative;
    box-sizing: border-box;
    opacity: 1;
    overflow: hidden;
  }

  /* Frame 1: Top Banner Image */
  .custom-hero__frame-1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 1440px;
    height: 390px;
    overflow: hidden;
    opacity: 1;
  }

  .custom-hero__img-1 {
    width: 100%;
    height: 390px;
    object-fit: cover;
    object-position: center;
    display: block;
    opacity: 1;
  }

  /* Left Content: Heading, Description, CTA Button */
  .custom-hero__content {
    position: absolute;
    top: 425px; /* 489px page Y - 64px navbar = 425px */
    left: 67px;
    width: 483px;
    display: flex;
    flex-direction: column;
    z-index: 2;
    opacity: 1;
  }

  .custom-hero__heading {
    margin: 0;
    padding: 0;
    width: 459px;
    min-height: 70px;
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 70px;
    line-height: 100%;
    letter-spacing: 0px;
    color: {{ section.settings.heading_color | default: '#000000' }};
    opacity: 1;
  }

  .custom-hero__description {
    margin: 50px 0 0 0; /* 609px - 489px - 70px = 50px gap */
    padding: 0;
    width: 483px;
    min-height: 84px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 20px;
    line-height: 140%;
    letter-spacing: 0px;
    color: {{ section.settings.description_color | default: '#000000' }};
    opacity: 1;
  }

  .custom-hero__btn {
    position: relative;
    margin-top: 50px; /* 743px - 609px - 84px = 50px gap */
    width: 220px;
    height: 50px;
    background-color: {{ section.settings.button_bg_color | default: '#000000' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    opacity: 1;
    overflow: hidden;
    z-index: 1;
  }

  .custom-hero__btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #FFF544;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 1;
  }

  .custom-hero__btn:hover::before {
    transform: scaleX(1);
  }

  .custom-hero__btn-text {
    position: relative;
    z-index: 2;
    width: 87px;
    height: 21px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    color: {{ section.settings.button_text_color | default: '#FFFFFF' }};
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s ease;
  }

  .custom-hero__btn:hover .custom-hero__btn-text {
    color: #000000;
  }

  .custom-hero__btn-arrow {
    position: relative;
    z-index: 2;
    width: 24px;
    height: 12px;
    display: block;
    flex-shrink: 0;
  }

  .custom-hero__btn-arrow path {
    stroke: {{ section.settings.button_text_color | default: '#FFFFFF' }};
    transition: stroke 0.3s ease;
  }

  .custom-hero__btn:hover .custom-hero__btn-arrow path {
    stroke: #000000;
  }

  /* Frame 2: Right Image */
  .custom-hero__frame-2 {
    position: absolute;
    top: 378px; /* 442px page Y - 64px navbar = 378px */
    left: 550px;
    width: 890px;
    height: 402px;
    overflow: hidden;
    opacity: 1;
    z-index: 1;
  }

  .custom-hero__img-2 {
    width: 890px;
    height: 402px;
    object-fit: cover;
    object-position: center;
    display: block;
    opacity: 1;
  }

  /* Responsive styling for screen widths below 1440px */
  @media screen and (max-width: 1440px) {
    .custom-hero {
      height: auto;
      min-height: auto;
      display: flex;
      flex-direction: column;
    }

    .custom-hero__frame-1 {
      position: relative;
      width: 100%;
      height: auto;
      aspect-ratio: 1440 / 390;
    }

    .custom-hero__img-1 {
      height: auto;
      aspect-ratio: 1440 / 390;
    }

    .custom-hero__lower-wrapper {
      display: flex;
      width: 100%;
      justify-content: space-between;
      padding: 30px 40px;
      box-sizing: border-box;
    }

    .custom-hero__content {
      position: relative;
      top: auto;
      left: auto;
      width: 45%;
    }

    .custom-hero__heading {
      font-size: clamp(40px, 4.5vw, 70px);
      width: 100%;
    }

    .custom-hero__description {
      width: 100%;
      font-size: 18px;
      margin-top: 30px;
    }

    .custom-hero__btn {
      margin-top: 30px;
    }

    .custom-hero__frame-2 {
      position: relative;
      top: auto;
      left: auto;
      width: 52%;
      height: auto;
      aspect-ratio: 890 / 402;
    }

    .custom-hero__img-2 {
      width: 100%;
      height: auto;
      aspect-ratio: 890 / 402;
    }
  }

  /* Responsive styling for Mobile */
  @media screen and (max-width: 900px) {
    .custom-hero {
      position: relative;
      width: 100%;
      height: 421px;
      min-height: 421px;
      background-color: #FFFFFF;
      overflow: hidden;
      display: block;
    }

    .custom-hero__frame-1 {
      display: none !important;
    }

    .custom-hero__lower-wrapper {
      display: block;
      position: static;
      width: 100%;
      height: 100%;
      padding: 0;
      margin: 0;
    }

    .custom-hero__content {
      display: block;
      position: static;
      width: 100%;
      height: 100%;
    }

    .custom-hero__heading {
      position: absolute;
      top: 49px;
      left: calc(50% - 98.5px);
      width: 197px;
      min-height: 30px;
      margin: 0;
      padding: 0;
      font-family: 'Jost', sans-serif;
      font-weight: 500;
      font-style: normal;
      font-size: 30px;
      line-height: 100%;
      letter-spacing: 0px;
      text-align: center;
      color: #000000;
      z-index: 2;
    }

    .custom-hero__description {
      position: absolute;
      top: 103px;
      left: calc(50% - 170px);
      width: 340px;
      min-height: 42px;
      margin: 0;
      padding: 0;
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 16px;
      line-height: 130%;
      letter-spacing: 0px;
      text-align: center;
      color: #000000;
      z-index: 2;
    }

    .custom-hero__desc-extra {
      display: none !important;
    }

    .custom-hero__frame-2 {
      position: absolute;
      top: 157px;
      left: calc(50% - 327.5px);
      width: 686px;
      height: 264px;
      overflow: hidden;
      z-index: 1;
      margin: 0;
      display: block;
    }

    .custom-hero__img-2 {
      width: 686px;
      height: 264px;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .custom-hero__btn {
      position: absolute;
      top: 337px;
      left: calc(50% - 96.5px);
      width: 193px;
      height: 45px;
      margin: 0;
      padding: 13px 20px;
      gap: 10px;
      z-index: 3;
      background-color: #000000;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
    }

    .custom-hero__btn-text {
      width: 119px;
      height: 19px;
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 16px;
      line-height: 20.48px;
      letter-spacing: 0px;
      text-align: center;
      vertical-align: middle;
      text-transform: uppercase;
      color: #F5F5F5;
    }

    .custom-hero__btn-arrow {
      width: 24px;
      height: 12px;
    }

    .custom-hero__btn-arrow path {
      stroke: #F5F5F5;
      stroke-width: 1.5;
    }
  }
</style>

<div class="custom-hero-wrapper" {{ section.shopify_attributes }}>
  <section class="custom-hero">
    <!-- Frame 1 -->
    <div class="custom-hero__frame-1">
      <img
        src="{% if section.settings.image_1 != blank %}{{ section.settings.image_1 | image_url: width: 2880 }}{% else %}{{ 'Frame1.png' | asset_url }}{% endif %}"
        alt="{{ section.settings.image_1_alt | default: 'Hero banner frame 1' }}"
        width="1440"
        height="390"
        class="custom-hero__img-1"
        loading="eager"
        fetchpriority="high"
      >
    </div>

    <!-- Container wrapper for lower section elements -->
    <div class="custom-hero__lower-wrapper">
      <!-- Left Content Column -->
      <div class="custom-hero__content">
        <h1 class="custom-hero__heading">
          {{ section.settings.heading | default: 'The Gift Guide' }}
        </h1>

        <p class="custom-hero__description">
          <span class="custom-hero__desc-short">Discover Joy: Your Ultimate Holiday Gift Destination.</span><span class="custom-hero__desc-extra"> Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</span>
        </p>

        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="custom-hero__btn">
          <span class="custom-hero__btn-text">
            {{ section.settings.button_text | default: 'Shop Now' }}
          </span>
          <svg
            class="custom-hero__btn-arrow"
            width="24"
            height="12"
            viewBox="0 0 24 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M0 6H22M22 6L16.5 1M22 6L16.5 11"
              stroke="{{ section.settings.button_text_color | default: '#FFFFFF' }}"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>

      <!-- Frame 2 -->
      <div class="custom-hero__frame-2">
        <img
          src="{% if section.settings.image_2 != blank %}{{ section.settings.image_2 | image_url: width: 1780 }}{% else %}{{ 'Frame2.png' | asset_url }}{% endif %}"
          alt="{{ section.settings.image_2_alt | default: 'Hero banner frame 2' }}"
          width="890"
          height="402"
          class="custom-hero__img-2"
          loading="lazy"
        >
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Custom Hero",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Image 1 (Frame 1)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image 1 Alt Text",
      "default": "Hero Banner Frame 1"
    },
    {
      "type": "header",
      "content": "Image 2 (Frame 2)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image 2 Alt Text",
      "default": "Hero Banner Frame 2"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero"
    }
  ]
}
{% endschema %}
