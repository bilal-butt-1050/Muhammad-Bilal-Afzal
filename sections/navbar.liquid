<style>
  .custom-navbar-wrapper {
    width: 100%;
    background: {{ section.settings.background_color | default: '#F5F5F5' }};
    opacity: 1;
  }

  .custom-navbar {
    width: 100%;
    max-width: 1440px;
    height: 64px;
    min-height: 64px;
    margin: 0 auto;
    padding: 10px 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 360px;
    box-sizing: border-box;
    opacity: 1;
  }

  .custom-navbar__left {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 151.44406127929688px;
    height: 19px;
    opacity: 1;
  }

  .custom-navbar__logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .custom-navbar__logo-img {
    width: 151.44406127929688px;
    height: 19px;
    opacity: 1;
    display: block;
  }

  .custom-navbar__center {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 260px;
    min-height: 14px;
    opacity: 1;
  }

  .custom-navbar__text {
    margin: 0;
    padding: 0;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 13.42px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
    color: {{ section.settings.text_color | default: '#000000' }};
    white-space: nowrap;
  }

  .custom-navbar__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    width: 207px;
    height: 44px;
    opacity: 1;
  }

  .custom-navbar__btn {
    position: relative;
    width: 207px;
    height: 44px;
    background: {{ section.settings.button_bg_color | default: '#FFF544' }};
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-decoration: none;
    opacity: 1;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
  }

  .custom-navbar__btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000000;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 1;
  }

  .custom-navbar__btn:hover::before {
    transform: scaleX(1);
  }

  .custom-navbar__btn-text {
    position: relative;
    z-index: 2;
    width: 102px;
    height: 21px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    color: #000000;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: color 0.3s ease;
  }

  .custom-navbar__btn:hover .custom-navbar__btn-text {
    color: #FFFFFF;
  }

  .custom-navbar__btn-arrow {
    position: relative;
    z-index: 2;
    width: 24px;
    height: 12px;
    display: block;
    flex-shrink: 0;
    opacity: 1;
  }

  .custom-navbar__btn-arrow path {
    stroke: #000000;
    transition: stroke 0.3s ease;
  }

  .custom-navbar__btn:hover .custom-navbar__btn-arrow path {
    stroke: #FFFFFF;
  }

  .custom-navbar__hamburger {
    display: none;
  }

  .custom-navbar__mobile-menu {
    display: none;
  }

  @media screen and (max-width: 1200px) {
    .custom-navbar {
      gap: 30px;
      padding: 10px 24px;
    }
  }

  @media screen and (max-width: 900px) {
    .custom-navbar-wrapper {
      position: relative;
      background: #F7F7F7;
      box-shadow: 0px 2px 4px 0px #00000026;
      width: 100%;
      z-index: 999;
    }

    .custom-navbar {
      width: 100%;
      max-width: 100%;
      height: 65px;
      min-height: 65px;
      padding: 23px 16px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-sizing: border-box;
      gap: 0;
    }

    /* Hamburger Button (3 bars, width: 18, height: 12, 2px stroke) */
    .custom-navbar__hamburger {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 12px;
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      cursor: pointer;
      line-height: 0;
      z-index: 10000;
      display: block;
    }

    .custom-navbar__hamburger::after {
      content: '';
      position: absolute;
      top: -12px;
      left: -12px;
      right: -12px;
      bottom: -12px;
      cursor: pointer;
    }

    .custom-navbar__hamburger-bar {
      display: block;
      width: 18px;
      height: 2px;
      background-color: #000000;
      position: absolute;
      left: 0;
      transform-origin: center;
      transition: transform 300ms ease-out, top 300ms ease-out, opacity 300ms ease-out;
    }

    .custom-navbar__hamburger-bar--1 {
      top: 0;
    }

    .custom-navbar__hamburger-bar--2 {
      top: 5px;
      opacity: 1;
    }

    .custom-navbar__hamburger-bar--3 {
      top: 10px;
    }

    /* Morph into cross: width ~12.73px, height ~13px, 2px stroke, 300ms ease-out */
    .custom-navbar-wrapper.is-menu-open .custom-navbar__hamburger-bar--1 {
      top: 5px;
      transform: rotate(45deg);
    }

    .custom-navbar-wrapper.is-menu-open .custom-navbar__hamburger-bar--2 {
      opacity: 0;
      transform: scaleX(0);
    }

    .custom-navbar-wrapper.is-menu-open .custom-navbar__hamburger-bar--3 {
      top: 5px;
      transform: rotate(-45deg);
    }

    .custom-navbar__left {
      width: 151.44px;
      height: 19px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }

    .custom-navbar__logo-img {
      width: 151.44px;
      height: 19px;
      display: block;
    }

    .custom-navbar__center,
    .custom-navbar__right {
      display: none !important;
    }

    /* Mobile Dropdown Menu (beneath navbar, top: 65px, height: 124px, background: #F2F2F2) */
    .custom-navbar__mobile-menu {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      position: absolute;
      top: 65px;
      left: 0;
      width: 100%;
      height: 124px;
      padding: 25px 16px;
      box-sizing: border-box;
      background: #F2F2F2;
      box-shadow: 0px 2px 4px 0px rgba(0, 0, 0, 0.08);
      z-index: 999;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 300ms ease-out, transform 300ms ease-out, visibility 300ms ease-out;
      pointer-events: none;
      overflow: hidden;
    }

    .custom-navbar-wrapper.is-menu-open .custom-navbar__mobile-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .custom-navbar__mobile-text {
      margin: 0;
      padding: 0;
      width: 260px;
      height: 14px;
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 16px;
      line-height: 13.42px;
      letter-spacing: 0px;
      text-align: center;
      vertical-align: middle;
      color: #000000;
      white-space: nowrap;
    }

    /* Mobile Choose Gift Button (244x44, #FFF544, black hover transition) */
    .custom-navbar__mobile-btn {
      position: relative;
      width: 244px;
      height: 44px;
      background: #FFF544;
      border: none;
      cursor: pointer;
      display: block;
      text-decoration: none;
      box-sizing: border-box;
      overflow: hidden;
      z-index: 1;
      opacity: 1;
    }

    .custom-navbar__mobile-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #000000;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
      z-index: 1;
    }

    .custom-navbar__mobile-btn:hover::before,
    .custom-navbar__mobile-btn:active::before {
      transform: scaleX(1);
    }

    .custom-navbar__mobile-btn-text {
      position: absolute;
      left: 57.9px;
      top: 11.67px;
      width: 102px;
      height: 21px;
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 16px;
      line-height: 20.48px;
      letter-spacing: 0px;
      text-align: center;
      vertical-align: middle;
      text-transform: uppercase;
      color: #000000;
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: color 0.3s ease;
    }

    .custom-navbar__mobile-btn:hover .custom-navbar__mobile-btn-text,
    .custom-navbar__mobile-btn:active .custom-navbar__mobile-btn-text {
      color: #FFFFFF;
    }

    .custom-navbar__mobile-btn-arrow {
      position: absolute;
      left: 189.78px;
      top: 21.55px;
      transform: translateY(-50%);
      width: 28.3px;
      height: 12px;
      display: block;
      flex-shrink: 0;
      z-index: 2;
    }

    .custom-navbar__mobile-btn-arrow path {
      stroke: #000000;
      transition: stroke 0.3s ease;
    }

    .custom-navbar__mobile-btn:hover .custom-navbar__mobile-btn-arrow path,
    .custom-navbar__mobile-btn:active .custom-navbar__mobile-btn-arrow path {
      stroke: #FFFFFF;
    }
  }
</style>

<div class="custom-navbar-wrapper" {{ section.shopify_attributes }}>
  <header class="custom-navbar">
    <!-- Animated Mobile Hamburger Menu (morphs into cross on open) -->
    <button
      type="button"
      class="custom-navbar__hamburger"
      id="custom-navbar-hamburger"
      aria-label="Toggle navigation"
      aria-expanded="false"
      onclick="toggleMobileNav()"
    >
      <span class="custom-navbar__hamburger-bar custom-navbar__hamburger-bar--1"></span>
      <span class="custom-navbar__hamburger-bar custom-navbar__hamburger-bar--2"></span>
      <span class="custom-navbar__hamburger-bar custom-navbar__hamburger-bar--3"></span>
    </button>

    <div class="custom-navbar__left">
      <a href="{{ routes.root_url }}" class="custom-navbar__logo-link" aria-label="{{ shop.name }}">
        <img
          src="{{ 'Group 1000007777.svg' | asset_url }}"
          alt="{{ shop.name }}"
          width="151.44"
          height="19"
          class="custom-navbar__logo-img"
        >
      </a>
    </div>

    <div class="custom-navbar__center">
      <p class="custom-navbar__text">
        {{ section.settings.text | default: 'Find the ideal gift for your loved ones.' }}
      </p>
    </div>

    <div class="custom-navbar__right">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="custom-navbar__btn">
        <span class="custom-navbar__btn-text">
          {{ section.settings.button_text | default: 'choose gift' }}
        </span>
        <svg
          class="custom-navbar__btn-arrow"
          width="24"
          height="12"
          viewBox="0 0 24 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0 6H22M22 6L16.5 1M22 6L16.5 11"
            stroke="#000000"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </header>

  <!-- Mobile Dropdown Menu (opens beneath navbar, height: 124px, background: #F2F2F2) -->
  <div class="custom-navbar__mobile-menu" id="custom-navbar-mobile-menu">
    <p class="custom-navbar__mobile-text">
      {{ section.settings.text | default: 'Find the ideal gift for your loved ones.' }}
    </p>
    <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="custom-navbar__mobile-btn">
      <span class="custom-navbar__mobile-btn-text">
        {{ section.settings.button_text | default: 'choose gift' }}
      </span>
      <svg
        class="custom-navbar__mobile-btn-arrow"
        width="29"
        height="12"
        viewBox="0 0 29 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0 6H26.5M26.5 6L21 1M26.5 6L21 11"
          stroke="#000000"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>
</div>

<script>
  function toggleMobileNav() {
    const wrapper = document.querySelector('.custom-navbar-wrapper');
    const hamburger = document.getElementById('custom-navbar-hamburger');
    if (!wrapper) return;

    const isOpen = wrapper.classList.toggle('is-menu-open');
    if (hamburger) {
      hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
  }

  document.addEventListener('click', function(e) {
    const wrapper = document.querySelector('.custom-navbar-wrapper');
    if (!wrapper) return;
    if (wrapper.classList.contains('is-menu-open') && !wrapper.contains(e.target)) {
      wrapper.classList.remove('is-menu-open');
      const hamburger = document.getElementById('custom-navbar-hamburger');
      if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
    }
  });
</script>

{% schema %}
{
  "name": "Navbar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Center Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "choose gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#FFF544"
    }
  ],
  "presets": [
    {
      "name": "Navbar"
    }
  ]
}
{% endschema %}
